{
  "manifest_version": 3,
  "name": "Transum Auto-Answer",
  "version": "1.0",
  "description": "Answer helper for Transum activities",
  "permissions": [],
  "content_scripts": [
    {
      "matches": ["*://www.transum.org/*", "*://transum.org/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
